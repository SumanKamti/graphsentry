# ==============================================================================
# GraphSentry Environment Configuration
# ==============================================================================

# --- FalkorDB Connection (Local, Remote, or Railway Private Network) ---
# For local Docker development:
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=graphsentry

# For Railway private networking (separate falkordb service in same project):
# FALKORDB_HOST=falkordb.railway.internal
# FALKORDB_PORT=6379
# FALKORDB_SSL=false

# --- Alternative: FalkorDB Full Connection URL ---
# Useful for FalkorDB Cloud or managed instances (e.g., falkors://user:password@host:port)
# If FALKORDB_URL is set, it takes precedence over individual host/port/ssl options.
FALKORDB_URL=

# --- Streamlit Cloud Hosting Port ---
# Cloud hosting platforms (Railway, Render, Heroku, etc.) automatically set PORT.
PORT=8501

# --- Optional Grounded AI Analyst Briefing (Groq) ---
# If omitted, GraphSentry automatically falls back to deterministic graph evidence synthesis.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

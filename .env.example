# FalkorDB connection. The provided Docker Compose file uses these defaults.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=graphsentry

# Optional: enables a grounded natural-language analyst brief.
# The app works without this key using a deterministic, evidence-based fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
